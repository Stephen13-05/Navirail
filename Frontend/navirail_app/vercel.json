{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/explorer",
      "destination": "/explorer/index.html"
    },
    {
      "source": "/explorer/",
      "destination": "/explorer/index.html"
    },
    {
      "source": "/explorer/((?!assets/|.*\\..*).*)$",
      "destination": "/explorer/index.html"
    },
    {
      "source": "/((?!explorer|assets|canvaskit|icons|.*\\..*).*)$",
      "destination": "/index.html"
    }
  ]
}
